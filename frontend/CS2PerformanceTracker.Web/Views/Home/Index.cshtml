@model CS2PerformanceTracker.Web.Viewmodels.PlayerDashboardViewModel

@functions {
    string GetAimColor(double value)
    {
        if (value >= 90)
        {
            return "text-danger";
        }

        if (value >= 60)
        {
            return "text-success";
        }

        return "text-primary";
    }
    
    
    string GetReactionTimeColor(double value)
    {
        if (value < 200)
            return "text-warning";

        return "text-primary";
    }

    string GetPreaimColor(double value)
    {
        if (value < 8)
        {
            return "text-danger";
        }
       
        return "text-primary";
    }
}

<h1 class="mb-4">CS2 Performance Tracker</h1>
<p class="subtitle">
    Analyze player performance using Steam and Leetify data
</p>

<form method="post" class="mb-5">

    <div class="mb-3">
        <label class="form-label">
            Steam64 ID
        </label>

        <input type="text"
               name="steamId"
               class="form-control"
               placeholder="Enter Steam64 ID" />
    </div>

    <button class="btn btn-primary">
        Search
    </button>

</form>

<!-- Display error message if there is one -->
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}


@if (Model?.Player != null)
{
    <div class="card mb-4">
        <div class="card-body d-flex align-items-center">

            @if (!string.IsNullOrEmpty(Model.Player.SteamAvatarUrl))
            {
                <img src="@Model.Player.SteamAvatarUrl"
                     class="rounded-circle me-4"
                     width="100"
                     height="100"
                     alt="Steam Avatar" />
            }

            <div>
                <h2 class="card-title">
                    @Model.Player.Username
                </h2>

                <p>
                    Steam ID: @Model.Player.SteamId
                </p>

                <p>
                    Faceit Level:
                    <strong>@Model.Player.FaceitLevel</strong>
                </p>

                <p>
                    Leetify Rating:
                    <strong>@Model.Player.LeetifyRating.ToString("0.0")</strong>
                </p>

                @if (!string.IsNullOrEmpty(Model.Player.SteamProfileUrl))
                {
                    <a href="@Model.Player.SteamProfileUrl" target="_blank">
                        View Steam Profile
                    </a>
                }
            </div>

        </div>
    </div>

    <div class="row">

        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>Aim</h5>
                    <h2 class="@GetAimColor(Model.Player.Aim)">
                        @Model.Player.Aim.ToString("0.0")
                    </h2>
                </div>
            </div>  
        </div>

        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>Preaim</h5>
                    <h2 class="@GetPreaimColor(Model.Player.Preaim)">
                        @Model.Player.Preaim.ToString("0.0")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>Utility</h5>
                    <h2>@Model.Player.Utility.ToString("0.0")</h2>
                </div>
            </div>
        </div>


        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>Positioning</h5>
                    <h2>@Model.Player.Positioning.ToString("0.0")</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>ReactionTimeMs</h5>
                    <h2 class="@GetReactionTimeColor(Model.Player.ReactionTimeMs)">
                        @Model.Player.ReactionTimeMs.ToString("0")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>SprayAccuracy</h5>
                    <h2>@Model.Player.SprayAccuracy.ToString("0.0")</h2>
                </div>
            </div>
        </div>

        @if (Model.RecentMatches.Any())
        {
            <div class="card mt-4">
                <div class="card-body">

                    <h3 class="mb-3">
                        Recent Matches
                    </h3>

                    <div class="table-responsive">
                        <table class="table table-dark table-striped">
                            <thead>
                                <tr>
                                    <th>Map</th>
                                    <th>Date</th>
                                    <th>Kills</th>
                                    <th>Deaths</th>
                                    <th>K/D</th>
                                    <th>Rating</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var match in Model.RecentMatches)
                                {
                                    <tr>
                                        <td>@match.MapName</td>

                                        <td>
                                            @match.FinishedAt.ToString("dd.MM.yyyy")
                                        </td>

                                        <td>@match.Kills</td>

                                        <td>@match.Deaths</td>

                                        <td>
                                            @match.KdRatio.ToString("0.00")
                                        </td>

                                        <td>
                                            @match.LeetifyRating.ToString("0.00")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        }

    </div>
}