@model CS2PerformanceTracker.Web.Models.PlayerStatsResponse

<h1>CS2 Performance Tracker</h1>

<form method="post">

    <label>Steam64 ID</label>

    <input type="text" name="steamId" />

    <button type="submit">
        Search
    </button>

</form>


@if (Model != null)
{
    <h2>@Model.Username</h2>

    <p>Faceit Level: @Model.FaceitLevel</p>

    <p>Leetify Rating: @Model.LeetifyRating</p>

    <p>Aim: @Model.Aim</p>

    <p>Utility: @Model.Utility</p>

    <p>Positioning: @Model.Positioning</p>
}