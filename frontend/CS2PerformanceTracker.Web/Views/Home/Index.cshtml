@model CS2PerformanceTracker.Web.Models.PlayerStatsResponse

<h1 class="mb-4">CS2 Performance Tracker</h1>

<form method="post" class="mb-5">

    <div class="mb-3">
        <label class="form-label">
            Steam64 ID
        </label>

        <input type="text"
               name="steamId"
               class="form-control"
               placeholder="Enter Steam64 ID" />
    </div>

    <button class="btn btn-primary">
        Search
    </button>

</form>

<!-- Display error message if there is one -->
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}


@if (Model != null)
{
    <div class="card mb-4">
        <div class="card-body">

            <h2 class="card-title">
                @Model.Username
            </h2>

            <p>
                Steam ID: @Model.SteamId
            </p>

            <p>
                Faceit Level:
                <strong>@Model.FaceitLevel</strong>
            </p>

            <p>
                Leetify Rating:
                <strong>@Model.LeetifyRating</strong>
            </p>

        </div>
    </div>

    <div class="row">

        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>Aim</h5>
                    <h2>@Model.Aim</h2>
                </div>
            </div>
        </div>


        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>Utility</h5>
                    <h2>@Model.Utility</h2>
                </div>
            </div>
        </div>


        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>Positioning</h5>
                    <h2>@Model.Positioning</h2>
                </div>
            </div>
        </div>

    </div>
}