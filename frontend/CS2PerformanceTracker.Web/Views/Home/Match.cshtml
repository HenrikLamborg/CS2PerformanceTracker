@model CS2PerformanceTracker.Web.Viewmodels.MatchDetailsViewModel

<div class="card bg-dark text-light">
    <div class="card-body">

        <h1 class="mb-4">
            Match Details
        </h1>

        <div class="mb-4">
            <h2>
                @Model.MapName
            </h2>

            <p class="text-secondary">
                @Model.FinishedAt.ToString("dd.MM.yyyy")
            </p>

            @if (Model.Won)
            {
                <span class="badge bg-success">WIN</span>
            }
            else
            {
                <span class="badge bg-danger">LOSS</span>
            }

            <h3 class="mt-3">
                @Model.Score
            </h3>
        </div>

        <div class="row">

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>Kills</h6>
                        <h3>@Model.Kills</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>Deaths</h6>
                        <h3>@Model.Deaths</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>K/D</h6>
                        <h3>@Model.KdRatio.ToString("0.00")</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>Leetify Rating</h6>
                        <h3>
                            @Model.LeetifyRating.ToString("+0.00;-0.00")
                        </h3>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>