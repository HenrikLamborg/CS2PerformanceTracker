@model CS2PerformanceTracker.Web.Viewmodels.MatchDetailsViewModel

@{
    string mapImage = Model.MapName switch
    {
        "de_dust2" => "/images/maps/de_dust2.png",
        "de_mirage" => "/images/maps/de_mirage.png",
        "de_nuke" => "/images/maps/de_nuke.png",
        "de_cache" => "/images/maps/de_cache.png",
        "de_inferno" => "/images/maps/de_inferno.png",
        "de_overpass" => "/images/maps/de_overpass.png",
        "de_vertigo" => "/images/maps/de_vertigo.png",
        "de_ancient" => "/images/maps/de_ancient.png",
        "de_anubis" => "/images/maps/de_anubis.png",
        _ => "/images/maps/default.jpg"
    };
}

<div class="card bg-dark text-light">
    <div class="card-body">

        <a asp-action="Index"
           asp-route-steamId="@Model.SteamId"
           class="btn btn-outline-light mb-4">
            ← Back to Dashboard
        </a>

        <div class="card bg-dark text-light mb-5 overflow-hidden position-relative">

            <img src="@mapImage"
                 class="w-100"
                 alt="@Model.MapName"
                 style="height: 300px; object-fit: cover;" />

            <div class="position-absolute top-0 start-0 w-100 h-100"
                 style="background: rgba(0, 0, 0, 0.55);">
            </div>

            <div class="position-absolute top-50 start-50 translate-middle text-center w-100">

                <h1 class="display-3 fw-bold">
                    @Model.MapName
                </h1>

                @if (Model.Won)
                {
                    <span class="badge bg-success fs-6">WIN</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">LOSS</span>
                }

                <h2 class="display-5 fw-bold mt-3">
                    @Model.Score
                </h2>

                <p class="text-light mb-0">
                    @Model.FinishedAt.ToString("dd.MM.yyyy")
                </p>

            </div>

        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">
                Combat Stats
            </h3>

            <button class="btn btn-outline-light"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#combatStats"
                    aria-expanded="true"
                    aria-controls="combatStats">
                −
            </button>
        </div>

        <div id="combatStats" class="collapse show">
        <div class="row">

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>Kills</h6>
                        <h3>@Model.Kills</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>Deaths</h6>
                        <h3>@Model.Deaths</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>K/D</h6>
                        <h3>@Model.KdRatio.ToString("0.00")</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>Leetify Rating</h6>
                        <h3>
                            @Model.LeetifyRating.ToString("+0.00;-0.00")
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>Damage</h6>
                        <h3>@Model.TotalDamage</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>Damage / Round</h6>
                        <h3>@Model.Dpr.ToString("0.00")</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>Assists</h6>
                        <h3>@Model.TotalAssists</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>Headshot Kills</h6>
                        <h3>@Model.TotalHsKills</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-light h-100">
                    <div class="card-body text-center">
                        <h6>MVPs</h6>
                        <h3>@Model.Mvps</h3>
                    </div>
                </div>
            </div>
            </div>
        </div>

        <div class="mt-5">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">
                    Aim Performance
                </h3>

                <button class="btn btn-outline-light"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#aimPerformance"
                        aria-expanded="false"
                        aria-controls="aimPerformance">
                    −
                </button>
            </div>

            <div id="aimPerformance" class="collapse">
            <div class="row">

                <div class="col-md-4 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Accuracy</h6>
                            <h3>
                                @((Model.Accuracy * 100).ToString("0.0"))%
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Head Accuracy</h6>
                            <h3>
                                @((Model.AccuracyHead * 100).ToString("0.0"))%
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Spray Accuracy</h6>
                            <h3>
                                @((Model.SprayAccuracy * 100).ToString("0.0"))%
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Preaim</h6>
                            <h3>
                                @Model.Preaim.ToString("0.00")
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Reaction Time</h6>
                            <h3>
                                @((Model.ReactionTime * 1000).ToString("0.0")) ms
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Counter-Strafing</h6>
                            <h3>
                                @((Model.CounterStrafingGoodRatio * 100).ToString("0.0"))%
                            </h3>
                        </div>
                    </div>
                </div>

            </div>
            </div>
        </div>


        <div class="mt-5">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">
                    Utility Performance
                </h3>

                <button class="btn btn-outline-light"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#utilityPerformance"
                        aria-expanded="false"
                        aria-controls="utilityPerformance">
                    −
                </button>
            </div>

            <div id="utilityPerformance" class="collapse">
            <div class="row">

                <div class="col-md-3 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>HE Grenades</h6>
                            <h3>@Model.HeThrown</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Molotovs</h6>
                            <h3>@Model.MolotovThrown</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Smokes</h6>
                            <h3>@Model.SmokeThrown</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Flashbangs</h6>
                            <h3>@Model.FlashbangThrown</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Flashes Hit</h6>
                            <h3>@Model.FlashbangHitFoe</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Flash Assists</h6>
                            <h3>@Model.FlashAssist</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Flash → Kill</h6>
                            <h3>@Model.FlashbangLeadingToKill</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>HE Damage</h6>
                            <h3>@Model.HeFoesDamageAvg.ToString("0.0")</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card bg-secondary text-light h-100">
                        <div class="card-body text-center">
                            <h6>Utility on Death</h6>
                            <h3>@Model.UtilityOnDeathAvg.ToString("0.0")</h3>
                        </div>
                    </div>
                </div>

            </div>
            </div>
        </div>

    </div>
</div>